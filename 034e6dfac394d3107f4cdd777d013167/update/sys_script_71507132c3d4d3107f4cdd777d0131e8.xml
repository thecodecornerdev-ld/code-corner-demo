        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Default Requested for to the person creating the record
	if (current.requested_for.nil())
		current.requested_for = gs.getUserID();

	// Every new request starts as New
	if (current.status.nil())
		current.status = 'new';

	// Make sure there is always a short description
	if (current.short_description.nil())
		current.short_description = 'Demo request for ' + current.requested_for.getDisplayValue();

})(current, previous);]]></script>
